{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app components/stockflow-frame.tsx components/order-workspace.tsx components/service-workspace.tsx components/pricing-workspace.tsx components/customer-price-book.tsx components/pricing-options.tsx lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:connector": "pwsh -NoProfile -File tests/connector-recovery.ps1 && pwsh -NoProfile -File tests/connector-sales-window.ps1",
    "test:pricing:db": "pwsh -NoProfile -File tests/pricing-migration-local.ps1",
    "test:pricing:deployment": "pwsh -NoProfile -File tests/pricing-migration-local.ps1 -DeploymentOrder",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pricing:e2e": "playwright test --config playwright.pricing.config.ts",
    "test:ci": "pnpm lint && pnpm typecheck && pnpm test:connector && pnpm test && pnpm build",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "ci": "pnpm test:ci && pnpm test:e2e && pnpm test:pricing:e2e && pnpm security:audit",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.11",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "4.133.0"
  },
  "type": "module"
}
