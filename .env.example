STOCKFLOW_READ_KEY=replace-with-the-hosted-secret
STOCKFLOW_ORDER_GATEWAY_KEY=replace-with-order-gateway-key
SUPABASE_URL=https://your-project.supabase.co

# Default preserves the existing Sites-managed sign-in. Never enable staff mode
# on the current Sites host. Configure an isolated direct host first.
STOCKFLOW_AUTH_MODE=sites
# Direct-host settings (server environment; no actual credentials in this file):
# STOCKFLOW_STAFF_ORIGIN=https://your-isolated-staff-host.example
# STOCKFLOW_AUTH_PUBLISHABLE_KEY=sb_publishable_replace-with-project-key
# Server-only provisioning credential; never use a NEXT_PUBLIC variable.
# STOCKFLOW_AUTH_ADMIN_KEY=sb_secret_replace-with-isolated-project-key
# Staff builds pin this non-secret deployment guard. Do not override it to reuse
# credentials or accounts from another project.
# STOCKFLOW_AUTH_EXPECTED_PROJECT=your-20-character-project-reference
# Enable only after SMTP delivery and the exact reset redirect are verified.
STOCKFLOW_AUTH_EMAIL_RESET_ENABLED=false
# Optional peer login origins: navigation only, not shared cookies/provider fallback.
# Configure only after BOTH hosts are verified against the SAME backend project.
# Never point the production app at the staff acceptance host.
# STOCKFLOW_PUBLIC_STAFF_ORIGIN=https://your-production-staff-host.example
# STOCKFLOW_PUBLIC_CHATGPT_ORIGIN=https://your-production-app.chatgpt.site
